# macOS
.DS_Store
._*

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.pyc
.venv/

# Local Claude state (machine-specific overrides)
.claude/settings.local.json

# Hook state — papers-processed manifest grows per-machine.
# Comment out if you want to share your processed-papers list across the lab.
.claude/hooks/papers-processed.txt

# Mounted host directories (never committed)
drop/
papers_input/
sra_pilot/

# Working scratch
tmp/
work/
archive/

# Obsidian Canvas (often binary-ish, conflict-prone)
*.canvas

# === Vault content: track scaffolding only ===
# Strategy: ignore everything in ObsidianVault/, then un-ignore the
# scaffolding directories and files. After cloning, you can sync your
# personal vault content into ObsidianVault/ and git will leave it alone.

ObsidianVault/**/*

# Scaffolding directories (so git can traverse into them)
!ObsidianVault/_Templates/
!ObsidianVault/_Templates/**
!ObsidianVault/!TASKS/
!ObsidianVault/!NEW-ARRIVALS/
!ObsidianVault/00_Inbox/
!ObsidianVault/00_Inbox/Papers/
!ObsidianVault/01_Research/
!ObsidianVault/01_Research/Raw/
!ObsidianVault/01_Research/Papers/
!ObsidianVault/01_Research/Concepts/
!ObsidianVault/01_Research/Projects/
!ObsidianVault/01_Research/Summaries/
!ObsidianVault/02_Admin/
!ObsidianVault/02_Admin/Meetings/
!ObsidianVault/02_Admin/Grants/
!ObsidianVault/03_Personal/
!ObsidianVault/03_Personal/Home/
!ObsidianVault/03_Personal/Family/
!ObsidianVault/03_Personal/Planning/
!ObsidianVault/04_Daily/
!ObsidianVault/05_News/
!ObsidianVault/90_Archive/

# Scaffolding files (specific markdown files to track)
!ObsidianVault/CLAUDE.md
!ObsidianVault/index.md
!ObsidianVault/log.md
!ObsidianVault/00_Home.md
!ObsidianVault/AI Workflow Guide.md
!ObsidianVault/!TASKS/TASKS.md
!ObsidianVault/!NEW-ARRIVALS/NEW-ARRIVALS.md
!ObsidianVault/00_Inbox/Papers/queue.md
!ObsidianVault/00_Inbox/claude-backlog.md

# Track .gitkeep everywhere (so empty content folders survive a clone)
!**/.gitkeep

# === Always-ignore (placed AFTER un-ignores so these patterns win) ===

# Binaries (vault is markdown-only by policy)
*.pdf
*.png
*.jpg
*.jpeg
*.gif
*.mp4
*.mp3
*.wav
*.zip
*.tar.gz
*.tgz
*.icloud

# Obsidian internals (volatile, machine-specific)
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
**/.obsidian/graph.json
**/.obsidian/backlink-in-document.json
**/.trash/
